# -- Next.js -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# -- FastAPI Backend -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://cspm:password@localhost:5432/cspm
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# -- AWS (CSPM platform credentials for sts:AssumeRole) -----------------------
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1

# -- Groq AI ------------------------------------------------------------------
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# -- Prowler Worker ------------------------------------------------------------
PROWLER_OUTPUT_DIR=/tmp/prowler-output

# -- Docker Compose (used by docker-compose.yml via variable interpolation) ----
POSTGRES_PASSWORD=password
